# ─────────────────────────────────────────────────────────────────────────────
# Volvia — local development environment
# Copy to .env  (cp .env.example .env)  — every service reads from this file.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=debug

# ── Datastores ───────────────────────────────────────────────────────────────
# Local Postgres runs on 55432 — 5432 and 5433 are already taken on this machine
# (5433 is a proxy to a remote database, so a plain port is genuinely unsafe here).
# In production this becomes the Neon *pooled* connection string.
DATABASE_URL=postgresql://volvia:volvia@localhost:55432/volvia
# Unpooled/direct URL, used by migrations only (Neon requires the direct URL here).
DATABASE_URL_UNPOOLED=postgresql://volvia:volvia@localhost:55432/volvia
REDIS_URL=redis://localhost:56379

# ── Public URLs ──────────────────────────────────────────────────────────────
API_URL=http://localhost:8080
WEB_URL=http://localhost:3000
APP_URL=http://localhost:3001
PASS_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_PASS_URL=http://localhost:3002

# ── API ──────────────────────────────────────────────────────────────────────
PORT=8080
# 32+ random bytes each. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0000000000000000
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-000000000000000
# Encrypts opaque public tokens (card links, pass auth tokens).
TOKEN_PEPPER=dev-only-token-pepper-change-me-00000000000000000
COOKIE_DOMAIN=localhost
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ── Email (Mailpit locally → Resend in production) ───────────────────────────
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=51025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="Volvia <hola@volvia.local>"

# ── Storage (MinIO locally → GCS in production) ──────────────────────────────
STORAGE_DRIVER=s3
STORAGE_BUCKET=volvia-uploads
STORAGE_ENDPOINT=http://localhost:59000
STORAGE_PUBLIC_URL=http://localhost:59000/volvia-uploads
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=volvia
STORAGE_SECRET_KEY=volvia-dev-secret
STORAGE_FORCE_PATH_STYLE=true

# ── Wallet passes ────────────────────────────────────────────────────────────
# stub = self-signed dev certificates (structure is real, Apple devices reject them)
# real = your Apple Pass Type ID certificate + Google Wallet service account
WALLET_MODE=stub
APPLE_PASS_TYPE_ID=pass.co.volvia.loyalty
APPLE_TEAM_ID=DEV0000000
APPLE_PASS_CERT_PATH=infra/certs/pass-cert.pem
APPLE_PASS_KEY_PATH=infra/certs/pass-key.pem
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERT_PATH=infra/certs/wwdr.pem
APPLE_PUSH_CERT_PATH=infra/certs/pass-cert.pem
GOOGLE_WALLET_ISSUER_ID=3388000000022000000
GOOGLE_WALLET_SA_EMAIL=volvia-dev@example.iam.gserviceaccount.com
GOOGLE_WALLET_SA_KEY_PATH=infra/certs/google-wallet-sa.json
GOOGLE_WALLET_CLASS_PREFIX=volvia_dev

# ── OAuth ────────────────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Billing ──────────────────────────────────────────────────────────────────
BILLING_ENABLED=true
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PRICE_PRO_MONTHLY=price_placeholder
STRIPE_PRICE_PRO_YEARLY=price_placeholder
STRIPE_PRICE_BUSINESS_MONTHLY=price_placeholder
STRIPE_PRICE_BUSINESS_YEARLY=price_placeholder
STRIPE_PRICE_MULTI_MONTHLY=price_placeholder
STRIPE_PRICE_MULTI_YEARLY=price_placeholder
WOMPI_PUBLIC_KEY=pub_test_placeholder
WOMPI_PRIVATE_KEY=prv_test_placeholder
WOMPI_EVENTS_SECRET=test_events_placeholder
WOMPI_INTEGRITY_SECRET=test_integrity_placeholder
WOMPI_BASE_URL=https://sandbox.wompi.co/v1

# ── Observability ────────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=

# Turn off only for the end-to-end suite, which signs up many businesses from one IP.
RATE_LIMIT_ENABLED=true
