{
  "name": "volvia",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev dev:worker --parallel",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @volvia/e2e test",
    "db:generate": "pnpm --filter @volvia/db generate",
    "db:migrate": "pnpm --filter @volvia/db migrate",
    "db:seed": "pnpm --filter @volvia/db seed",
    "db:studio": "pnpm --filter @volvia/db studio",
    "db:reset": "pnpm --filter @volvia/db reset",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "infra:nuke": "docker compose -f infra/docker-compose.yml down -v",
    "certs:dev": "bash infra/scripts/gen-dev-certs.sh",
    "bootstrap": "bash infra/scripts/bootstrap.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "tsx": "^4.19.2"
  }
}
