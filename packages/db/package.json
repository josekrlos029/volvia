  "devDependencies": {
    "@types/node": "^22.10.2",
    "@volvia/config": "workspace:*",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
